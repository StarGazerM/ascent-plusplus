; Canonical minimal rewrite test — commutativity of a binary constructor.
; Source: egglog's own proof_encoding.md docs example.
;
; Cross-check: `egglog add_commutative.egg` should exit 0.
; Ported to ascent_tests_dd/src/egglog_port.rs::add_commutative_rewrite.

(sort Math)
(constructor Add (i64 i64) Math)
(Add 1 2)
(rule ((Add a b))
      ((union (Add a b) (Add b a)))
     :name "commutativity")
(run 1)
(check (= (Add 1 2) (Add 2 1)))
